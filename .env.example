NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional alias supported by this codebase:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Required for privileged server writes/bypassing RLS in trusted API routes.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# MongoDB (required by existing marketing/newsletter/staff API routes)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/your_db

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mail (used by newsletter/notifications routes)
EMAIL_USER=you@example.com
EMAIL_PASS=your-email-app-password
